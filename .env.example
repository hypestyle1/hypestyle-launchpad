# ─────────────────────────────────────────────────────────────────────────────
# Hypestyle Launchpad — variables de entorno
#
# Copiar a `next-app/.env.local` y completar. NUNCA commitear el archivo con
# valores reales: `.env*` está en .gitignore.
#
# Lo mínimo para levantar la tienda y ver el catálogo son las dos primeras.
# El resto habilita checkout, panel e integraciones.
# ─────────────────────────────────────────────────────────────────────────────

# ── WordPress / WooCommerce ──────────────────────────────────────────────────
# Públicas: se inlinean en el bundle del navegador. No poner secretos acá.
NEXT_PUBLIC_WP_URL=
NEXT_PUBLIC_GRAPHQL_URL=
NEXT_PUBLIC_FRONTEND_URL=

# WooCommerce REST API (WP Admin → WooCommerce → Ajustes → Avanzado → REST API)
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Secreto compartido con el mu-plugin `hypestyle-api` (rutas hypestyle/v1)
WP_SECRET=

# WP Application Password, para subir medios
WP_MEDIA_USER=
WP_MEDIA_APP_PASSWORD=

# ── Panel de administración ──────────────────────────────────────────────────
ADMIN_SECRET=
ADMIN_SESSION_SECRET=
MAYORISTA_SESSION_SECRET=

# ── Pagos ────────────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RECONCILE_LIVE=false

GOCUOTAS_API_KEY=
GOCUOTAS_WEBHOOK_SECRET=

# ── Envíos ───────────────────────────────────────────────────────────────────
# Credencial del plugin Andreani de WooCommerce (campo hash_andreani)
ANDREANI_SESSION_TOKEN=

# ── Mail (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=
CONTENT_MANAGER_EMAIL=
SUPPLIER_EMAIL=

# ── Medición ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_EVENT_CODE=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Meta Ads (panel) ─────────────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=

# ── Instagram (feed del home) ────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── n8n (bot de WhatsApp/Instagram) ──────────────────────────────────────────
N8N_API_URL=
N8N_API_KEY=
N8N_ADMIN_REPLY_URL=
N8N_ADMIN_REPLY_SECRET=
N8N_MONTHLY_LIMIT=

# ── Reseñas ──────────────────────────────────────────────────────────────────
HS_REVIEWS_SECRET=
NEXT_PUBLIC_REVIEWS_DEMO_MODE=false

# ── Traducción de fichas por IA ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=

# ── Crons de Vercel ──────────────────────────────────────────────────────────
CRON_SECRET=
ABANDONED_ENABLED=false
WELCOME_SEQUENCE_ENABLED=false

# ── Feature flags y varios ───────────────────────────────────────────────────
EARLY_ACCESS_PASSWORD=
PROMO_TEST_SECRET=
PROMO_3X2_DISABLED=false
PROMO_CHAMPION_DISABLED=false
HS_REFUNDS_ENABLED=false
HPG_SECRET=

# Widget de partido en vivo (descuento por gol)
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_MATCH_ID=
NEXT_PUBLIC_MATCH_KICKOFF=

# ── Tests E2E (opcional) ─────────────────────────────────────────────────────
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_PORT=
